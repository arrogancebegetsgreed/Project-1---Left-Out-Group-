@startuml

enum GRADE_POINTS {
    
A+: 4.3 
A: 4.0
A-: 3.7
B+: 3.3
B: 3.0 
B-: 2.7
C+: 2.3
C: 2.0
C-: 1.7
D+: 1.3
D: 1.0
D-: 0.7
F: 0.0
}

Class User {
+id:String{id}
+name:String
+about:String
+Passwd:LargeBinary



}

Class Course {
+prefix:String{id}
+number:String{id}
+name:String
+credits:Integer


}

Class Enrollment {
+User_ID:String {id}
+Course_Prefix:String{id}
+Course_Number:String{id}
+Grade:String


}

User --> Enrollment
Course --> Enrollment
@enduml
